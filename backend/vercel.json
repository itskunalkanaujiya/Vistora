{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,**/__pycache__/**,.pytest_cache/**,Dockerfile,requirements-dev.txt,pytest.ini}"
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/warm",
      "schedule": "30 1 * * *"
    }
  ]
}
