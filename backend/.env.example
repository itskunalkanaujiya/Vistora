# Copy this file to .env and fill in your own values.

# Required: SerpApi key used for Google Lens searches (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=your-serpapi-key-here

# Optional: set to false to skip AI visual re-ranking (faster, less accurate)
ENABLE_CLIP_RANKING=true

# Optional: CLIP image encoder used for visual re-ranking
CLIP_MODEL_NAME=kunalkanaujiya/clip-vit-base-patch32-vision

# Virtual try-on: Hugging Face token whose free GPU quota is used. Locally,
# `hf auth login` is used if this is not set. A read-only token is enough.
HF_TOKEN=
TRYON_LIMIT=5
TRYON_WINDOW_SECONDS=600
# Live try-on (sunglasses, watches): product photos prepared per window.
OVERLAY_LIMIT=150

# Optional: searches allowed per client (IP address) per window. Cached
# results don't count. Set SEARCH_LIMIT=0 to disable the limit.
SEARCH_LIMIT=10
SEARCH_WINDOW_SECONDS=600

# Optional: Serper.dev key (https://serper.dev). Text search uses it first
# (faster, more relevant) and photo search uses it to fill missing prices.
SERPER_API_KEY=

# The fast photo provider is OFF by default, because its credits do not renew.
# Turn it on for a demo from the admin address (see the README), or set
# FAST_PHOTO=on to keep it on.
FAST_PHOTO=

# Optional fast photo search: SearchApi.io key (https://www.searchapi.io) and
# a public Vercel Blob store token, used to give SearchApi a temporary link
# to the photo (deleted right after). Photo search falls back to SerpApi.
SEARCHAPI_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Optional: Groq key (https://console.groq.com/keys, free tier) so a language
# model reads sentence-style text searches ("a phone good for gaming under
# 20k"). Without it, a rule-based reader is used. GROQ_MODEL defaults to
# qwen/qwen3.8-27b (then openai/gpt-oss-20b).
GROQ_API_KEY=

# Optional: Gemini key (https://aistudio.google.com/apikey, free tier) for
# Find the outfit. Gemini Flash finds more items and places their boxes
# better than the Groq model, which stays as the fallback. GEMINI_MODEL
# defaults to gemini-3.5-flash (then gemini-3.5-flash-lite).
GEMINI_API_KEY=

# Optional: when a provider is "low" on searches. GET /api/v1/usage/status
# returns 503 below these, so an uptime monitor can email you in time.
LOW_CREDITS_SERPAPI=25
LOW_CREDITS_SEARCHAPI=15
LOW_CREDITS_SERPER=50

# How long a saved search result is reused, in hours (default 24). Longer saves
# more search credits but shows older prices; the results page shows the age.
CACHE_TTL_HOURS=24

# Optional shared cache (https://upstash.com, free tier; or add Upstash Redis
# from the Vercel Marketplace, which sets KV_REST_API_URL and KV_REST_API_TOKEN).
# Without it, results are cached per server instance only, and lost on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional daily job that keeps the most-searched text searches warm in the
# shared cache. CRON_SECRET is set in Vercel so only its cron can call it.
# Each query it searches costs one Serper search (2 credits), so it is OFF by
# default (WARM_LIMIT=0). Set WARM_LIMIT to the number of queries to warm per
# day to turn it on; it never runs below WARM_KEEP_SEARCHES text searches left.
CRON_SECRET=
WARM_LIMIT=0
WARM_KEEP_SEARCHES=300
WARM_TTL_SECONDS=93600
